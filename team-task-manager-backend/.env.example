# Environment configuration
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/team_task_manager
DATABASE_URL=postgresql+asyncpg://postgres:pulkit@localhost:5432/team_task_manager
SECRET_KEY=your-super-secret-key-change-in-production-12345678901234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment settings
DEBUG=True
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Rate limiting (in-memory demo)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

